{
  "name": "dsh-tool-gongwen",
  "version": "0.1.0",
  "description": "DSH 插件：按 GB/T 9704—2012《党政机关公文格式》生成与校验中文公文（DOCX / PDF），纯 JS 实现，零外部依赖",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "assets/**",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gongwen",
    "gb-t-9704",
    "docx",
    "chinese-official-document"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longaotiandedage/dsh-tool-gongwen.git"
  },
  "homepage": "https://github.com/longaotiandedage/dsh-tool-gongwen#readme",
  "bugs": {
    "url": "https://github.com/longaotiandedage/dsh-tool-gongwen/issues"
  },
  "author": "longaotiandedage",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
